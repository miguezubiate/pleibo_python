# Ejecutar python scripts/init_env.py para generar .env con secretos aleatorios.
MYSQL_DATABASE=ghibli
MYSQL_USER=ghibli
MYSQL_PASSWORD=GENERATE_ME
MYSQL_ROOT_PASSWORD=GENERATE_ME
DATABASE_URL=mysql+pymysql://ghibli:GENERATE_ME@mysql:3306/ghibli?charset=utf8mb4
JWT_SECRET_KEY=GENERATE_ME
REDIS_URL=redis://redis:6379/0
GHIBLI_BASE_URL=https://ghibliapi.vercel.app
ENABLE_DOCS=true
TRUST_PROXY=false
